# Switchyard needs no secrets or environment file in offline proof mode.
# Uncomment only a deliberate local override; safe defaults are shown below.
#
# SWITCHYARD_HOST=127.0.0.1
# SWITCHYARD_PORT=8000
# SWITCHYARD_DATABASE_URL=sqlite:///./switchyard.db
# SWITCHYARD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# SWITCHYARD_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
# SWITCHYARD_INITIAL_STOP=false
